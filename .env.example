# AEGIS local environment example.
# Copy this file to .env for local demos and replace placeholder values.
# Never commit real private keys, encrypted keys, API keys, or funded wallets.

# -----------------------------------------------------------------------------
# Next.js dashboard and Hedera public RPCs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=https://mainnet.hashio.io/api
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_MAINNET_URL=https://mainnet.mirrornode.hedera.com
HEDERA_MIRROR_TESTNET_URL=https://testnet.mirrornode.hedera.com
NEXT_PUBLIC_IGNORE_BUILD_ERROR=false
NEXT_PUBLIC_IPFS_BUILD=false

# -----------------------------------------------------------------------------
# 0G Galileo Agentic ID integration
# Preferred variable names used by the Next.js backend route.
# -----------------------------------------------------------------------------
ZERO_G_PRIVATE_KEY=0x_your_funded_0g_galileo_private_key
ZERO_G_AGENTIC_ID_CONTRACT_ADDRESS=0x2700F6A3e505402C9daB154C5c6ab9cAEC98EF1F
ZERO_G_GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_GALILEO_CHAIN_ID=16602
ZERO_G_EXPLORER_BASE_URL=https://chainscan-galileo.0g.ai
ZERO_G_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZERO_G_STORAGE_URI_PREFIX=0g-storage://

# Compatibility aliases also accepted by the 0G Agentic ID backend.
# Keep these aligned with the ZERO_G_* values if you use root .env loading.
PRIVATE_KEY=0x_your_funded_0g_galileo_private_key
RPC_URL=https://evmrpc-testnet.0g.ai
CHAIN_ID=16602
STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
AGENTIC_ID_CONTRACT=0x2700F6A3e505402C9daB154C5c6ab9cAEC98EF1F
EXPLORER_BASE_URL=https://chainscan-galileo.0g.ai
STORAGE_URI_PREFIX=0g-storage://

# -----------------------------------------------------------------------------
# 0G decision verifier service
# -----------------------------------------------------------------------------
PORT=4000

# -----------------------------------------------------------------------------
# Cosigner service
# -----------------------------------------------------------------------------
COSIGNER_PRIVATE_KEY=0x_your_cosigner_private_key
COSIGNER_PORT=4100
SAFE_ADDRESS=0x_your_safe_address

# -----------------------------------------------------------------------------
# Hedera contract tooling
# -----------------------------------------------------------------------------
HEDERA_RPC_URL=https://testnet.hashio.io/api
DEPLOYER_PRIVATE_KEY_ENCRYPTED=your_encrypted_deployer_key_json
LOCALHOST_KEYSTORE_ACCOUNT=scaffold-hbar-default
ALCHEMY_API_KEY=your_alchemy_api_key
