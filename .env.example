# Shared AEGIS local environment example.
# Package-specific variables remain in each package's .env.example.
# Copy the required values to .env and replace placeholder values.
# Never commit real private keys, encrypted keys, API keys, or funded wallets.

# -----------------------------------------------------------------------------
# Next.js dashboard and Hedera public RPCs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=https://mainnet.hashio.io/api
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_MAINNET_URL=https://mainnet.mirrornode.hedera.com
HEDERA_MIRROR_TESTNET_URL=https://testnet.mirrornode.hedera.com
NEXT_PUBLIC_IGNORE_BUILD_ERROR=false
NEXT_PUBLIC_IPFS_BUILD=false

# -----------------------------------------------------------------------------
# 0G Galileo Agentic ID integration
# Preferred variable names used by the Next.js backend route.
# -----------------------------------------------------------------------------
ZERO_G_PRIVATE_KEY=0x_your_funded_0g_galileo_private_key
ZERO_G_AGENTIC_ID_CONTRACT_ADDRESS=0x2700F6A3e505402C9daB154C5c6ab9cAEC98EF1F
ZERO_G_GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_GALILEO_CHAIN_ID=16602
ZERO_G_EXPLORER_BASE_URL=https://chainscan-galileo.0g.ai
ZERO_G_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZERO_G_STORAGE_URI_PREFIX=0g-storage://
# Shared backend-to-backend bearer token; use the same random 32+ character value in both services.
AEGIS_AGENTIC_ID_INTERNAL_TOKEN=
# Positive integer from 1 through 900000.
AEGIS_AGENTIC_ID_REGISTRATION_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# 0G semantic verifier
# Hackathon testnet explicitly uses verified/TeeTLS with non-sealed inference.
# The upstream model may process plaintext. This is never an automatic fallback.
# Omitting the profile defaults to production-private-teeml, which requires
# the mainnet Router, a private TeeML model, and sealed inference.
# -----------------------------------------------------------------------------
ZG_TEEML_SECURITY_PROFILE=hackathon-testnet-teetls
# Total network budget shared across every network call in a verification.
# Positive integer from 3 through 300000.
ZG_TEEML_TIMEOUT_MS=30000
# Positive integer; the strict verdict schema needs well over 256 tokens.
ZG_TEEML_MAX_OUTPUT_TOKENS=768

# Hackathon testnet-teetls profile: direct 0G Compute SDK integration (the
# Router proxy's completions leave the provider's signed-response endpoint
# unresolvable afterward - see docs/0g/teeml-semantic-verifier.md).
# Funded 0G Galileo testnet wallet paying for ledger/inference settlement.
ZG_COMPUTE_PRIVATE_KEY=0x_your_funded_0g_galileo_private_key
# Exact on-chain provider address to pin (no catalog-based discovery).
ZG_TEEML_PROVIDER_ADDRESS=0xa48f01287233509FD694a22Bf840225062E67836
# Exact provider-side model id (not the canonical alias).
ZG_TEEML_PROVIDER_MODEL_ID=qwen/qwen2.5-omni-7b

# Production example (mainnet Router, unchanged):
# ZG_TEEML_SECURITY_PROFILE=production-private-teeml
# ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
# ZG_ROUTER_API_KEY=<sk- Router inference key from pc.0g.ai>
# ZG_TEEML_MODEL=<current-mainnet-private-teeml-model>

# -----------------------------------------------------------------------------
# Agent service and Policy Engine Level 1 persistence
# -----------------------------------------------------------------------------
AGENT_SERVICE_PORT=4200
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev
POSTGRES_DB=aegis_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aegis:aegis_dev@localhost:5432/aegis_dev
TEST_DATABASE_URL=postgresql://aegis:aegis_dev@localhost:5432/aegis_test
USAGE_HOLD_TTL_SECONDS=300
AUDIT_RETENTION_DAYS=90
# JSON object mapping each agentId to a unique random 32+ character bearer token.
AEGIS_AGENT_AUTH_TOKENS_JSON=

# -----------------------------------------------------------------------------
# Cosigner service
# -----------------------------------------------------------------------------
COSIGNER_PRIVATE_KEY=0x_your_cosigner_private_key
COSIGNER_PORT=4100
SAFE_ADDRESS=0x_your_safe_address

# -----------------------------------------------------------------------------
# Hedera contract tooling
# -----------------------------------------------------------------------------
HEDERA_RPC_URL=https://testnet.hashio.io/api
DEPLOYER_PRIVATE_KEY_ENCRYPTED=your_encrypted_deployer_key_json
LOCALHOST_KEYSTORE_ACCOUNT=scaffold-hbar-default
ALCHEMY_API_KEY=your_alchemy_api_key
