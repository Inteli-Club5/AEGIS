AGENT_SERVICE_PORT=4200

# AEGIS's own Hedera operator account - funds/executes AccountCreateTransaction
# for each new agent. Demo key in .env ONLY - never exposed to the user;
# local HSM/MPC/TEE in prod, always self-hosted (see docs/AEGIS_ARCHITECTURE.md §9.2).
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.demo_operator
HEDERA_OPERATOR_KEY=0x_demo_key

# Initial HBAR balance funded into each new agent account. Needs to cover the
# agent's own Safe deployment gas plus a
# margin, since the agent - not AEGIS - pays for creating its own wallet.
AGENT_INITIAL_BALANCE_HBAR=0.5

# Groq - LLM backing each agent's reasoning (propose-actions).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# EVM RPC used for Safe deployment (create-wallets). Same network as
# HEDERA_NETWORK above.
RPC_URL=https://testnet.hashio.io/api

# AEGIS co-signer's EVM address (public - matches the account behind
# COSIGNER_PRIVATE_KEY in services/cosigner/.env). One institutional key
# across every deployment (docs/decisions.md) - listed here as a Safe owner,
# never as a private key.
AEGIS_COSIGNER_ADDRESS=
