AGENT_SERVICE_PORT=4200

# PostgreSQL operational source of truth for Policy Engine Level 1.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev
POSTGRES_DB=aegis_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aegis:aegis_dev@localhost:5432/aegis_dev
TEST_DATABASE_URL=postgresql://aegis:aegis_dev@localhost:5432/aegis_test
USAGE_HOLD_TTL_SECONDS=300
AUDIT_RETENTION_DAYS=90
# JSON object mapping each agentId to a unique random 32+ character bearer token.
AEGIS_AGENT_AUTH_TOKENS_JSON=

# AEGIS's own Hedera operator account - funds/executes AccountCreateTransaction
# for each new agent. Demo key in .env ONLY - never exposed to the user;
# production key custody is outside this branch (see docs/aegis-current-scope.md).
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.demo_operator
HEDERA_OPERATOR_KEY=0x_demo_key

# Initial HBAR balance funded into each new agent account. Needs to cover the
# agent's own Safe deployment gas plus a
# margin, since the agent - not AEGIS - pays for creating its own wallet.
AGENT_INITIAL_BALANCE_HBAR=0.5

# Groq - LLM backing each agent's reasoning (propose-actions).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# EVM RPC used for Safe deployment (create-wallets). Same network as
# HEDERA_NETWORK above.
RPC_URL=https://testnet.hashio.io/api

# AEGIS co-signer's EVM address (public - matches the account behind
# COSIGNER_PRIVATE_KEY in services/cosigner/.env). One institutional key
# across every deployment (docs/decisions.md) - listed here as a Safe owner,
# never as a private key.
AEGIS_COSIGNER_ADDRESS=

# Optional demo/test override. Use a distinct address so the Safe retains three
# unique owners. Do not treat an address without a controlled key as a real
# recovery path in production.
AEGIS_RECOVERY_GUARDIAN_ADDRESS=

# Base URL of the AEGIS Next.js dashboard, used by register-agentic-id to call
# POST /api/0g/agentic-id after an agent's Safe wallet is deployed.
AEGIS_DASHBOARD_URL=http://localhost:3000
# Same random 32+ character secret as the Next.js service.
AEGIS_AGENTIC_ID_INTERNAL_TOKEN=
# Positive integer from 1 through 900000.
AEGIS_AGENTIC_ID_REGISTRATION_TIMEOUT_MS=300000
ZERO_G_AGENTIC_ID_CONTRACT_ADDRESS=0x2700F6A3e505402C9daB154C5c6ab9cAEC98EF1F
ZERO_G_GALILEO_CHAIN_ID=16602

# 0G semantic verifier. The explicit hackathon profile uses verified/TeeTLS on
# testnet with non-sealed inference; the upstream model may process
# plaintext. It is never an automatic fallback and cannot authorize
# production execution. Omitting the profile defaults to production-private-teeml,
# which requires the mainnet Router, a private TeeML model, and sealed inference.
ZG_TEEML_SECURITY_PROFILE=hackathon-testnet-teetls
# Total network budget shared across every network call in a verification.
# Positive integer from 3 through 300000.
ZG_TEEML_TIMEOUT_MS=30000
# Positive integer; the strict verdict schema needs well over 256 tokens.
ZG_TEEML_MAX_OUTPUT_TOKENS=768

# Hackathon testnet-teetls profile: direct 0G Compute SDK integration.
# The Router's own completion proxy leaves the provider's signed-response
# endpoint unresolvable afterward (chat_id_not_found); the SDK's direct
# broker/ledger session against the same provider verifies successfully. See
# docs/0g/teeml-semantic-verifier.md.
# Funded 0G Galileo testnet wallet paying for ledger/inference settlement.
# Never a wallet used for anything beyond testnet compute payment.
ZG_COMPUTE_PRIVATE_KEY=0x_your_funded_0g_galileo_private_key
# Exact on-chain provider address to pin (no catalog-based discovery).
ZG_TEEML_PROVIDER_ADDRESS=0xa48f01287233509FD694a22Bf840225062E67836
# Exact provider-side model id (not the canonical alias) returned by
# broker.inference.getServiceMetadata; verified before every completion.
ZG_TEEML_PROVIDER_MODEL_ID=qwen/qwen2.5-omni-7b

# Production example (mainnet Router, unchanged from the Router integration):
# ZG_TEEML_SECURITY_PROFILE=production-private-teeml
# ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
# ZG_ROUTER_API_KEY=<sk- Router inference key from pc.0g.ai>
# ZG_TEEML_MODEL=<current-mainnet-private-teeml-model>
