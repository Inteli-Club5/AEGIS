      "checkConstraints": {
        "aegis_asset_catalog_network_check": {
          "name": "aegis_asset_catalog_network_check",
          "value": "\"network_id\" = 'hedera:testnet'"
        },
        "aegis_asset_catalog_decimals_check": {
          "name": "aegis_asset_catalog_decimals_check",
          "value": "\"decimals\" >= 0 AND \"decimals\" <= 30"
        },
        "aegis_asset_catalog_hbar_check": {
          "name": "aegis_asset_catalog_hbar_check",
          "value": "(\"kind\" <> 'HBAR') OR (\"asset_id\" = 'hedera:testnet:hbar' AND \"hedera_token_id\" IS NULL AND \"decimals\" = 8)"
        },
        "aegis_asset_catalog_hts_check": {
          "name": "aegis_asset_catalog_hts_check",
          "value": "(\"kind\" <> 'HTS_FUNGIBLE') OR (\"asset_id\" LIKE 'hedera:testnet:hts:%' AND \"hedera_token_id\" IS NOT NULL)"
        }
      },
      "isRLSEnabled": false
    },
